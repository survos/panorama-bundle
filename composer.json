{
  "name": "survos/panorama-bundle",
  "description": "Reusable panorama tours and historical photograph overlays for Symfony UX",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "symfony-ux",
    "panorama"
  ],
  "require": {
    "php": "^8.5",
    "survos/kit-bundle": "^2.41.9",
    "survos/data-contracts": "^2.45.6",
    "symfony/asset-mapper": "^8.1",
    "symfony/http-client-contracts": "^3.0",
    "symfony/http-foundation": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/stimulus-bundle": "^3.0",
    "symfony/ux-twig-component": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Survos\\PanoramaBundle\\": "src/"
    }
  },
  "suggest": {
    "symfony/ux-leaflet-map": "Required for the optional streetview component and its Symfony UX Map instance"
  }
}
